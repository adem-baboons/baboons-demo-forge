[Unit]
Description=Baboons Demo Forge — MCP server for *.baboons.dev demo deploys
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=baboons-deploy
Group=baboons-deploy
WorkingDirectory=/opt/baboons-demo-forge
EnvironmentFile=/etc/baboons-demo-forge/forge.env
ExecStart=/opt/baboons-demo-forge/.venv/bin/python -m server.main
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=baboons-demo-forge

# Hardening — the service writes to /var/www/demos and reads /etc/baboons-demo-forge,
# nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/demos
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
