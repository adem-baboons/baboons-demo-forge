[Unit]
Description=Baboons Demo Forge — MCP server for *.baboons.dev demo deploys
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=baboons-deploy
Group=baboons-deploy
WorkingDirectory=/opt/baboons-demo-forge
EnvironmentFile=/etc/baboons-demo-forge/forge.env
# FastMCP otherwise tries to write a version cache under $HOME on startup,
# which collides with ProtectHome=true. Disable the check at the unit level
# so this stays correct after a fresh install.
Environment=FASTMCP_CHECK_FOR_UPDATES=off
# pnpm's default store location is $HOME/.pnpm-store, blocked by
# ProtectHome=true. Redirect to a path inside the demos tree (already in
# ReadWritePaths) so `pnpm install` works for vite/next builds. The store
# is content-addressed and shared across deploys, so subsequent installs
# hit cache and finish in seconds.
Environment=PNPM_STORE_DIR=/var/www/demos/.forge/pnpm-store
# pnpm also reads ~/.npmrc / ~/.pnpmrc for config, blocked by ProtectHome.
# Point HOME at the same tmp area so any incidental reads land somewhere
# writable — pnpm tolerates an empty config.
Environment=HOME=/var/www/demos/.forge/pnpm-home
ExecStart=/opt/baboons-demo-forge/.venv/bin/python -m server.main
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=baboons-demo-forge

# Hardening — the service writes to /var/www/demos and /etc/caddy/sites.d
# (per-slug Caddy snippets) and reads /etc/baboons-demo-forge.
#
# NoNewPrivileges=true is intentionally NOT set: the service relies on
# `sudo systemctl reload caddy` to apply demo snippets, and NoNewPrivileges
# blocks all sudo elevation regardless of sudoers permissions.
#
# The accepted blast radius is bounded by /etc/sudoers.d/baboons-demo-forge-caddy,
# which permits exactly one command: `/usr/bin/systemctl reload caddy`.
# The remaining hardening (ProtectSystem=strict, ReadWritePaths, ProtectHome,
# PrivateTmp, RestrictSUIDSGID, etc.) constrains everything else.
#
# Considered alternative: polkit rule granting reload via dbus, which would
# allow keeping NoNewPrivileges=true. Rejected for setup complexity.
PrivateTmp=true
ProtectSystem=strict
# `-` prefix on /etc/caddy/sites.d makes the path optional: systemd skips it
# if the directory does not exist (e.g. on first boot before the migration
# script has run, or if Caddy is uninstalled). Without this prefix the
# service fails 226/NAMESPACE on a clean host.
ReadWritePaths=/var/www/demos -/etc/caddy/sites.d
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
